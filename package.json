{
  "name": "wideners-baby-punting-adventure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "commitlint": "commitlint",
    "firebase:preview": "firebase hosting:channel:deploy preview --expires 7d",
    "firebase:deploy": "firebase deploy --only hosting"
  },
  "dependencies": {
    "pixi.js": "^8.0.0",
    "planck": "^1.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "firebase-tools": "^14.5.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
